#!/bin/bash
#
# yas-webdeploy
#
# Fast, private, context-aware deployment script using rsync.
# Designed as an alternative to git push for production environments.
#
# Features:
# - SSH / SFTP deployment
# - Respects .gitignore exclusions
# - Multiple deployment instances
# - Context-aware post-deployment (WebKernel, Laravel, Static)
# - Optimized transfers with rsync
#
# Author: El Moumen Yassine
# License: MPL-2.0
#
# Usage:
#   yas-webdeploy [--sync-without-delai] [profile]
#
# Configuration:
#   Edit web-sync.config.json or pass a profile path as the first argument
#

set -euo pipefail

SYNC_WITHOUT_DELAY=false
if [[ "${1:-}" == --sync-without-delai ]]; then
  SYNC_WITHOUT_DELAY=true
  shift
fi
CONFIG_FILE="${1:-$PWD/web-sync.config.json}"
if [[ "$CONFIG_FILE" != /* ]]; then CONFIG_FILE="$PWD/$CONFIG_FILE"; fi
CONFIG_DIR="${CONFIG_FILE%/*}"
CONFIG_DIR="$(cd -- "$CONFIG_DIR" && pwd -P)"
GITIGNORE_FILE="$CONFIG_DIR/.gitignore"

BASE_DEPENDENCIES=(jq)
SSH_DEPENDENCIES=(ssh rsync)
SFTP_DEPENDENCIES=(sftp)
SSH_PASSWORD_DEPENDENCIES=(sshpass)
SUDO_PASSWORD_DEPENDENCIES=(base64 tr)
GITIGNORE_DEPENDENCIES=(sed)

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
else
  C_RESET=''
  C_BOLD=''
  C_BLUE=''
  C_CYAN=''
  C_GREEN=''
  C_YELLOW=''
  C_RED=''
fi

say_info() { printf '%s•%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
say_step() { printf '\n%s▶%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
say_success() { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
say_warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
say_error() { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

check_dependencies() {
  local dependency
  local -a missing=()

  for dependency in "$@"; do
    command -v "$dependency" >/dev/null 2>&1 || missing+=("$dependency")
  done

  if (( ${#missing[@]} )); then
    say_error "Missing required dependencies: ${missing[*]}"
    exit 1
  fi
}

ensure_config_file_is_in_gitignore() {
  local config_entry="${CONFIG_FILE##*/}"
  local ignore_line
  local last_line=""
  local found=false

  [[ -f "$GITIGNORE_FILE" ]] || : > "$GITIGNORE_FILE"

  while IFS= read -r ignore_line || [[ -n "$ignore_line" ]]; do
    last_line="$ignore_line"
    if [[ "$ignore_line" == "$config_entry" || "$ignore_line" == "/$config_entry" ]]; then
      found=true
    fi
  done < "$GITIGNORE_FILE"

  if [[ "$found" != true ]]; then
    [[ -z "$last_line" ]] || printf '\n' >> "$GITIGNORE_FILE"
    printf '%s\n' "$config_entry" >> "$GITIGNORE_FILE"
  fi
}

create_default_config() {
cat > "$CONFIG_FILE" << 'EOF'
{
  "server": "your-server.com",
  "user": "your-username",
  "ssh_port": 22,
  "method": "ssh",
  "unsafe_mode": false,
  "ssh_password": "",
  "sudo_password": "",
  "remote_chown": "",
  "remote_sudo": false,
  "remote_staging_root": "$HOME/.web-sync-staging",
  "deploys": {
    "Production": {
      "enable": true,
      "source": ".",
      "dest": "/var/www/production",
      "type": "webkernel"
    }
  }
}
EOF
  say_success "Created default JSON configuration: $CONFIG_FILE"
  say_info "Edit the config, then run the script again."
  exit 0
}

build_rsync_excludes() {
  local context="$1"
  local -a excludes=(--exclude=.git)

  case $context in
    webkernel|laravel)
      excludes+=(--exclude=.env --exclude=bootstrap/cache/)
      ;;
  esac

  if [[ -f "$GITIGNORE_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      [[ -z "$line" || "$line" =~ ^# ]] && continue
      excludes+=(--exclude="$line")
    done < "$GITIGNORE_FILE"
  fi

  RSYNC_EXCLUDES=("${excludes[@]}")
}

RSYNC_EXCLUDES=()

run_post_deploy() {
  local host="$1"
  local target="$2"
  local context="$3"

  case $context in
    webkernel)
      echo ""
      echo "Running WebKernel post-deployment tasks..."
      ssh "${SSH_OPTIONS[@]}" "$host" "cd $target && composer update --no-dev --optimize-autoloader && php artisan migrate --force && php artisan config:cache && php artisan route:cache && php artisan view:cache"
      ;;
    laravel)
      echo ""
      echo "Running Laravel post-deployment tasks..."
      ssh "${SSH_OPTIONS[@]}" "$host" "cd $target && composer update --no-dev --optimize-autoloader && php artisan migrate --force && php artisan config:cache && php artisan route:cache && php artisan view:cache"
      ;;
    static)
      echo ""
      echo "Static site deployed, no post-deployment tasks needed"
      ;;
  esac
}

show_help() {
  cat <<'HELP'
Usage: yas-webdeploy [--sync-without-delai] [profile]

Pass a .json profile for the full deployment workflow (requires jq), or a
KEY=value profile for the simple SSH/rsync workflow (no jq required).
KEY=value profiles support SOURCE=. for local files or SOURCE=user@host:/path
for a remote source. Remote sources are relayed through this machine.
--sync-without-delai preflights both servers, tries direct remote transfer,
and otherwise relays short batches with resumable tracking.
HELP
}

# Active state is global so the EXIT trap can clean up even after a function returns.
ND_CONTROL_DIR=''
ND_RELAY_DIR=''
ND_ASKPASS_HELPER=''
ND_SOURCE_SOCKET=''
ND_DEST_SOCKET=''
ND_SOURCE_ENDPOINT=''
ND_DEST_ENDPOINT=''
ND_SOURCE_PORT=''
ND_DEST_PORT=''
ND_PROGRESS_BASE=0
ND_PROGRESS_TOTAL=1
ND_PROGRESS_PHASE=''
ND_PROGRESS_FILE=0
ND_PROGRESS_FILES=0
ND_PROGRESS_FILE_BYTES=0

cleanup_no_delay() {
  if [[ -n "$ND_SOURCE_SOCKET" && -n "$ND_SOURCE_ENDPOINT" ]]; then
    ssh -S "$ND_SOURCE_SOCKET" -O exit -p "$ND_SOURCE_PORT" "$ND_SOURCE_ENDPOINT" >/dev/null 2>&1 || true
  fi
  if [[ -n "$ND_DEST_SOCKET" && -n "$ND_DEST_ENDPOINT" ]]; then
    ssh -S "$ND_DEST_SOCKET" -O exit -p "$ND_DEST_PORT" "$ND_DEST_ENDPOINT" >/dev/null 2>&1 || true
  fi
  if [[ -n "$ND_CONTROL_DIR" && -d "$ND_CONTROL_DIR" ]]; then
    find "$ND_CONTROL_DIR" -depth -delete >/dev/null 2>&1 || true
  fi
  [[ -z "$ND_ASKPASS_HELPER" ]] || unlink "$ND_ASKPASS_HELPER" >/dev/null 2>&1 || true
}

overall_progress_line() {
  local done_bytes=$1 total_bytes=$2 phase=$3 file_index=$4 file_count=$5
  local width=28 percent=0 filled blank_bar fill_bar rest_bar
  (( total_bytes > 0 )) && percent=$((done_bytes * 100 / total_bytes))
  (( percent > 100 )) && percent=100
  filled=$((percent * width / 100))
  printf -v blank_bar '%*s' "$width" ''
  fill_bar=${blank_bar:0:filled}
  rest_bar=${blank_bar:filled}
  fill_bar=${fill_bar// /#}
  rest_bar=${rest_bar// /-}
  if [[ -t 1 ]]; then
    printf '\r\033[K[%s%s] %3d%% %-8s file %d/%d' "$fill_bar" "$rest_bar" "$percent" "$phase" "$file_index" "$file_count"
  else
    printf '[%s%s] %3d%% %-8s file %d/%d\n' "$fill_bar" "$rest_bar" "$percent" "$phase" "$file_index" "$file_count"
  fi
}

consume_rsync_progress() {
  local line current_bytes done_bytes last_percent=-1
  while IFS= read -r -d $'\r' line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*([0-9,]+)[[:space:]]+([0-9]+)% ]]; then
      current_bytes=${BASH_REMATCH[1]//,/}
      (( current_bytes > ND_PROGRESS_FILE_BYTES )) && current_bytes=$ND_PROGRESS_FILE_BYTES
      done_bytes=$((ND_PROGRESS_BASE + current_bytes))
      local percent=0
      (( ND_PROGRESS_TOTAL > 0 )) && percent=$((done_bytes * 100 / ND_PROGRESS_TOTAL))
      if [[ -t 1 || "$percent" != "$last_percent" ]]; then
        overall_progress_line "$done_bytes" "$ND_PROGRESS_TOTAL" "$ND_PROGRESS_PHASE" "$ND_PROGRESS_FILE" "$ND_PROGRESS_FILES"
        last_percent=$percent
      fi
    elif [[ -n "${line//$'\n'/}" ]]; then
      [[ -t 1 ]] && printf '\r\033[K'
      printf '%s\n' "$line"
    fi
  done
  [[ -t 1 ]] && printf '\r\033[K'
}

run_metered_rsync() {
  local password=$1
  shift
  local status
  set +e
  if [[ -n "$password" ]]; then
    YAS_WEBDEPLOY_ASKPASS_PASSWORD="$password" SSH_ASKPASS="$ND_ASKPASS_HELPER" SSH_ASKPASS_REQUIRE=force DISPLAY="${DISPLAY:-yas-webdeploy:0}" LC_ALL=C "$@" 2>&1 | consume_rsync_progress
  else
    LC_ALL=C "$@" 2>&1 | consume_rsync_progress
  fi
  status=${PIPESTATUS[0]}
  set -e
  return "$status"
}

open_ssh_master() {
  local endpoint=$1 port=$2 socket=$3 password=$4 label=$5
  local -a options=(-M -N -f -S "$socket" -o ControlMaster=yes -o ControlPersist=24h -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -p "$port")
  say_step "Checking $label connection"
  if [[ -n "$password" ]]; then
    YAS_WEBDEPLOY_ASKPASS_PASSWORD="$password" SSH_ASKPASS="$ND_ASKPASS_HELPER" SSH_ASKPASS_REQUIRE=force DISPLAY="${DISPLAY:-yas-webdeploy:0}" ssh "${options[@]}" "$endpoint"
  else
    ssh "${options[@]}" -o BatchMode=yes "$endpoint"
  fi
  say_success "$label connection is ready"
}

run_sync_without_delay() {
  local server=$1 user=$2 ssh_port=$3 dest=$4 ssh_password=$5
  local source_path=$6 source_ssh_port=$7 source_ssh_password=$8 relay_tmpdir=$9
  local host="$user@$server" source_remote='' source_endpoint='' source_root=''
  local dest_control_path source_control_path dest_ssh source_ssh relay_state inventory state_hash
  local source_kind direct_command source_remote_q dest_path_q source_path_q remote_parent_q remote_command
  local file_size file_mtime relative_path file_id marker signature local_file parent_path
  local total_files=0 total_bytes=0 fetched_bytes=0 sent_bytes=0 fetched_files=0 sent_files=0
  local current_index=0 inventory_path source_find_command batch_number=0 batch_bytes=0 batch_start_index=0
  local fetch_batch_bytes=0 remote_mkdir_command parent_dir candidate_dir known
  local -a batch_paths=() batch_sizes=() batch_mtimes=() batch_ids=() batch_needs_fetch=()
  local -a dest_directories=()

  check_dependencies ssh rsync find mktemp cksum mkdir mv chmod unlink || return 1
  [[ "$source_path" =~ ^[^/:]+@[^/:]+:.+ ]] && source_kind=remote || source_kind=local
  ND_DEST_ENDPOINT="$host"
  ND_DEST_PORT="$ssh_port"
  if [[ "$source_kind" == remote ]]; then
    source_remote="$source_path"
    [[ "$source_remote" == */ ]] || source_remote+="/"
    source_endpoint=${source_remote%%:*}
    source_root=${source_remote#*:}
    ND_SOURCE_ENDPOINT="$source_endpoint"
    ND_SOURCE_PORT="$source_ssh_port"
  fi

  relay_state="${XDG_STATE_HOME:-$HOME/.local/state}/yas-webdeploy"
  state_hash=$(printf '%s' "$CONFIG_FILE" | cksum)
  state_hash=${state_hash%% *}
  relay_state="$relay_state/$state_hash"
  ND_RELAY_DIR="$relay_state/spool"
  mkdir -p "$ND_RELAY_DIR" "$relay_state/downloaded" "$relay_state/sent" || { say_error 'Cannot create relay state directory'; return 1; }
  inventory_path="$relay_state/inventory.nul"
  ND_CONTROL_DIR=$(mktemp -d "${relay_tmpdir%/}/yas-webdeploy-control.XXXXXX") || { say_error 'Cannot create private SSH control directory'; return 1; }
  ND_ASKPASS_HELPER="$askpass_helper"
  ND_SOURCE_SOCKET="$ND_CONTROL_DIR/source-%C"
  ND_DEST_SOCKET="$ND_CONTROL_DIR/destination-%C"
  trap cleanup_no_delay EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  open_ssh_master "$host" "$ssh_port" "$ND_DEST_SOCKET" "$ssh_password" 'destination'
  if [[ "$source_kind" == remote ]]; then
    open_ssh_master "$source_endpoint" "$source_ssh_port" "$ND_SOURCE_SOCKET" "$source_ssh_password" 'source'
    if [[ "$source_root" == '~/'* ]]; then
      local source_relative=${source_root#~/} source_relative_q
      printf -v source_relative_q '%q' "$source_relative"
      ssh -S "$ND_SOURCE_SOCKET" -p "$source_ssh_port" "$source_endpoint" "cd ~/$source_relative_q && test -d ." || { say_error 'The remote source directory is not accessible'; return 1; }
    else
      printf -v source_path_q '%q' "$source_root"
      ssh -S "$ND_SOURCE_SOCKET" -p "$source_ssh_port" "$source_endpoint" "test -d $source_path_q" || { say_error 'The remote source directory is not accessible'; return 1; }
    fi
  else
    [[ -d "$source_path" ]] || { say_error "Source directory not found: $source_path"; return 1; }
  fi

  printf -v dest_path_q '%q' "$dest"
  ssh -S "$ND_DEST_SOCKET" -p "$ssh_port" "$host" "mkdir -p -- $dest_path_q && test -w $dest_path_q" || { say_error 'The destination directory cannot be created or written'; return 1; }
  say_success 'Both endpoints passed the connection and directory checks'

  if [[ "$source_kind" == local ]]; then
    dest_ssh="ssh -S $(printf '%q' "$ND_DEST_SOCKET") -o ControlMaster=auto -o ControlPersist=24h -p $ssh_port -o ConnectTimeout=15"
    [[ -n "$ssh_password" ]] || dest_ssh+=" -o BatchMode=yes"
    if [[ -n "$ssh_password" ]]; then
      rsync -az --no-owner --no-group --partial --append-verify --info=progress2 --no-inc-recursive --stats --timeout=30 -e "$dest_ssh" "$source_path/" "$host:$dest/"
    else
      rsync -az --no-owner --no-group --partial --append-verify --info=progress2 --no-inc-recursive --stats --timeout=30 -e "$dest_ssh" "$source_path/" "$host:$dest/"
    fi
    say_success 'Local source synchronized directly to destination'
    return 0
  fi

  # First try a destination-side pull. It needs destination-to-source SSH key access.
  printf -v source_remote_q '%q' "$source_remote"
  printf -v dest_path_q '%q' "$dest/"
  local direct_probe direct_source_ssh
  printf -v direct_probe_source_q '%q' "$source_endpoint"
  direct_source_ssh="ssh -p $source_ssh_port -o BatchMode=yes -o ConnectTimeout=6"
  direct_probe="command -v rsync >/dev/null 2>&1 && ssh -p $source_ssh_port -o BatchMode=yes -o ConnectTimeout=6 $direct_probe_source_q true"
  say_step 'Checking whether destination can pull directly from source'
  if ssh -S "$ND_DEST_SOCKET" -p "$ssh_port" "$host" "$direct_probe" >/dev/null 2>&1; then
    printf -v direct_source_q '%q' "$source_remote"
    direct_command="rsync -az --no-owner --no-group --partial --append-verify --info=progress2 --no-inc-recursive --stats --timeout=30 -e '$direct_source_ssh' $direct_source_q $dest_path_q"
    say_step 'Direct source-to-destination transfer (overall progress)'
    if ssh -S "$ND_DEST_SOCKET" -p "$ssh_port" "$host" "$direct_command"; then
      printf '%s\n' 'direct transfer completed' > "$relay_state/direct-complete"
      say_success 'Direct transfer completed; no local relay copy was needed'
      return 0
    fi
    say_warn 'Direct transfer stopped; continuing through the local relay and resuming completed files'
  else
    say_info 'Destination cannot pull from source; relaying files through this machine'
  fi

  # Inventory uses tab-separated metadata; the path is the final field and may contain spaces.
  if [[ "$source_root" == '~/'* ]]; then
    local source_relative=${source_root#~/} source_relative_q
    printf -v source_relative_q '%q' "$source_relative"
    source_find_command="cd ~/$source_relative_q && find . \\( -type f -o -type l \\) -printf '%s\\t%T@\\t%P\\n'"
  else
    printf -v source_path_q '%q' "$source_root"
    source_find_command="find $source_path_q \\( -type f -o -type l \\) -printf '%s\\t%T@\\t%P\\n'"
  fi
  say_step 'Scanning source inventory'
  ssh -S "$ND_SOURCE_SOCKET" -p "$source_ssh_port" "$source_endpoint" "$source_find_command" > "$inventory_path" || { say_error 'Could not list source files'; return 1; }
  while IFS=$'\t' read -r file_size file_mtime relative_path; do
    [[ -z "$file_size" ]] && continue
    total_files=$((total_files + 1))
    total_bytes=$((total_bytes + file_size))
  done < "$inventory_path"
  (( total_files > 0 )) || { say_error 'The source directory contains no regular files'; return 1; }
  ND_PROGRESS_TOTAL=$((total_bytes * 2))
  say_info "Queued $total_files files ($total_bytes bytes); small files will be sent in short batches"
  say_info "Resume state: $relay_state"

  dest_ssh="ssh -S $(printf '%q' "$ND_DEST_SOCKET") -o ControlMaster=auto -o ControlPersist=24h -p $ssh_port -o ConnectTimeout=15"
  [[ -n "$ssh_password" ]] || dest_ssh+=" -o BatchMode=yes"
  source_ssh="ssh -S $(printf '%q' "$ND_SOURCE_SOCKET") -o ControlMaster=auto -o ControlPersist=24h -p $source_ssh_port -o ConnectTimeout=15"
  [[ -n "$source_ssh_password" ]] || source_ssh+=" -o BatchMode=yes"

  flush_batch() {
    local i signature id marker path local_item
    local files_list="$relay_state/batch.files0"
    local fetch_list="$relay_state/fetch.files0"
    local fetch_index=0
    (( ${#batch_paths[@]} > 0 )) || return 0
    batch_number=$((batch_number + 1))
    : > "$files_list"
    : > "$fetch_list"
    fetch_batch_bytes=0
    for i in "${!batch_paths[@]}"; do
      printf '%s\0' "${batch_paths[i]}" >> "$files_list"
      if [[ "${batch_needs_fetch[i]}" == true ]]; then
        printf '%s\0' "${batch_paths[i]}" >> "$fetch_list"
        fetch_batch_bytes=$((fetch_batch_bytes + batch_sizes[i]))
      fi
    done

    if (( fetch_batch_bytes > 0 )); then
      ND_PROGRESS_BASE=$((fetched_bytes + sent_bytes))
      ND_PROGRESS_PHASE='fetch'
      ND_PROGRESS_FILE=$batch_start_index
      ND_PROGRESS_FILES=$total_files
      ND_PROGRESS_FILE_BYTES=$fetch_batch_bytes
      say_step "Fetching batch $batch_number (${#batch_paths[@]} files)"
      run_metered_rsync "$source_ssh_password" rsync -a -r -R --no-owner --no-group --from0 --files-from="$fetch_list" --partial --append-verify --info=progress2 --timeout=30 -e "$source_ssh" "$source_endpoint:${source_root%/}/" "$ND_RELAY_DIR/"
      for i in "${!batch_paths[@]}"; do
        [[ "${batch_needs_fetch[i]}" == true ]] || continue
        path=${batch_paths[i]}
        local_item="$ND_RELAY_DIR/$path"
        [[ -e "$local_item" || -L "$local_item" ]] || { say_error "Source transfer did not create $path in the relay"; return 1; }
        signature="${batch_sizes[i]}|${batch_mtimes[i]}"
        id=${batch_ids[i]}
        marker="$relay_state/downloaded/$id"
        printf '%s\n' "$signature" > "$marker.tmp.$$"
        mv -f -- "$marker.tmp.$$" "$marker"
        fetched_bytes=$((fetched_bytes + batch_sizes[i]))
        fetched_files=$((fetched_files + 1))
      done
    fi

    # Create each nested destination directory once per batch, then send the batch in one rsync.
    dest_directories=()
    remote_mkdir_command='mkdir -p --'
    for path in "${batch_paths[@]}"; do
      parent_dir=${path%/*}
      [[ "$parent_dir" != "$path" ]] || continue
      candidate_dir="$dest/$parent_dir"
      known=false
      for i in "${dest_directories[@]}"; do
        [[ "$i" == "$candidate_dir" ]] && { known=true; break; }
      done
      [[ "$known" == true ]] && continue
      dest_directories+=("$candidate_dir")
      printf -v remote_parent_q '%q' "$candidate_dir"
      remote_mkdir_command+=" $remote_parent_q"
    done
    if (( ${#dest_directories[@]} > 0 )); then
      ssh -S "$ND_DEST_SOCKET" -p "$ssh_port" "$host" "$remote_mkdir_command" || { say_error "Cannot prepare destination directories for batch $batch_number"; return 1; }
    fi

    ND_PROGRESS_BASE=$((fetched_bytes + sent_bytes))
    ND_PROGRESS_PHASE='send'
    ND_PROGRESS_FILE=$batch_start_index
    ND_PROGRESS_FILES=$total_files
    ND_PROGRESS_FILE_BYTES=$batch_bytes
    say_step "Sending batch $batch_number (${#batch_paths[@]} files)"
    run_metered_rsync "$ssh_password" rsync -a -r -R --no-owner --no-group --from0 --files-from="$files_list" --partial --append-verify --info=progress2 --timeout=30 -e "$dest_ssh" "$ND_RELAY_DIR/" "$host:$dest/"
    for i in "${!batch_paths[@]}"; do
      signature="${batch_sizes[i]}|${batch_mtimes[i]}"
      id=${batch_ids[i]}
      marker="$relay_state/sent/$id"
      printf '%s\n' "$signature" > "$marker.tmp.$$"
      mv -f -- "$marker.tmp.$$" "$marker"
      local_item="$ND_RELAY_DIR/${batch_paths[i]}"
      [[ ! -e "$local_item" && ! -L "$local_item" ]] || unlink "$local_item"
      sent_bytes=$((sent_bytes + batch_sizes[i]))
      sent_files=$((sent_files + 1))
    done
    overall_progress_line "$((fetched_bytes + sent_bytes))" "$ND_PROGRESS_TOTAL" 'sent' "$((batch_start_index + ${#batch_paths[@]} - 1))" "$total_files"
    batch_paths=()
    batch_sizes=()
    batch_mtimes=()
    batch_ids=()
    batch_needs_fetch=()
    batch_bytes=0
    batch_start_index=0
  }

  while IFS=$'\t' read -r file_size file_mtime relative_path; do
    [[ -z "$file_size" ]] && continue
    current_index=$((current_index + 1))
    file_id=$(printf '%s' "$relative_path" | cksum)
    file_id=${file_id%% *}
    signature="$file_size|$file_mtime"
    marker="$relay_state/sent/$file_id"
    if [[ -f "$marker" ]] && IFS= read -r value < "$marker" && [[ "$value" == "$signature" ]]; then
      fetched_bytes=$((fetched_bytes + file_size))
      sent_bytes=$((sent_bytes + file_size))
      fetched_files=$((fetched_files + 1))
      sent_files=$((sent_files + 1))
      overall_progress_line "$((fetched_bytes + sent_bytes))" "$ND_PROGRESS_TOTAL" 'sent' "$current_index" "$total_files"
      continue
    fi

    local_file="$ND_RELAY_DIR/$relative_path"
    marker="$relay_state/downloaded/$file_id"
    local have_file=false
    if [[ -f "$marker" && ( -e "$local_file" || -L "$local_file" ) ]] && IFS= read -r value < "$marker" && [[ "$value" == "$signature" ]]; then
      have_file=true
      fetched_bytes=$((fetched_bytes + file_size))
      fetched_files=$((fetched_files + 1))
    fi
    if (( ${#batch_paths[@]} == 0 )); then batch_start_index=$current_index; fi
    batch_paths+=("$relative_path")
    batch_sizes+=("$file_size")
    batch_mtimes+=("$file_mtime")
    batch_ids+=("$file_id")
    batch_needs_fetch+=("$([[ "$have_file" == true ]] && printf false || printf true)")
    batch_bytes=$((batch_bytes + file_size))

    if (( ${#batch_paths[@]} >= 32 || batch_bytes >= 8388608 )); then
      flush_batch
    fi
  done < "$inventory_path"
  flush_batch

  [[ -t 1 ]] && printf '\n'
  say_success "Sync complete: $sent_files/$total_files files sent; $sent_bytes/$total_bytes source bytes delivered"
  printf '%s\n' 'Run state retained for safe re-runs.'
}

run_key_value_profile() {
  local server='' user='' ssh_port='22' source_path='.' dest=''
  local ssh_password='' source_ssh_password='' source_ssh_port='22'
  local line key value line_number=0 remote_source=false source_remote='' source_host=''
  local relay_dir='' relay_tmpdir="${TMPDIR:-/tmp}" askpass_helper='' askpass_display="${DISPLAY:-yas-webdeploy:0}"
  local dest_ssh="ssh -p 22" source_ssh='' host=''

  fail_profile() { say_error "$*"; return 1; }
  if [[ ! -f "$CONFIG_FILE" || ! -r "$CONFIG_FILE" ]]; then
    fail_profile "Config file not found or unreadable: $CONFIG_FILE"
    return 1
  fi

  if [[ "${CONFIG_FILE##*.}" == json ]]; then
    local deployment_count source_kind source_host source_user source_path_json
    deployment_count=$(jq '[.deployments[] | select(.enabled != false)] | length' "$CONFIG_FILE")
    [[ "$deployment_count" == 1 ]] || { fail_profile 'Nested JSON profiles currently require exactly one enabled deployment'; return 1; }
    server=$(jq -r '.destination.server.host // empty' "$CONFIG_FILE")
    user=$(jq -r '.destination.server.user // empty' "$CONFIG_FILE")
    ssh_port=$(jq -r '.destination.server.ssh.port // 22' "$CONFIG_FILE")
    ssh_password=$(jq -r '.destination.server.ssh.password // ""' "$CONFIG_FILE")
    dest=$(jq -r '.destination.path // empty' "$CONFIG_FILE")
    source_kind=$(jq -r '.source.kind // empty' "$CONFIG_FILE")
    source_path_json=$(jq -r '.source.path // empty' "$CONFIG_FILE")
    source_ssh_port=$(jq -r '.source.server.ssh.port // 22' "$CONFIG_FILE")
    source_ssh_password=$(jq -r '.source.server.ssh.password // ""' "$CONFIG_FILE")
    relay_tmpdir=$(jq -r '.this_machine.temporary_directory // "system-default"' "$CONFIG_FILE")
    [[ "$relay_tmpdir" == system-default ]] && relay_tmpdir="${TMPDIR:-/tmp}"
    if [[ "$source_kind" == remote ]]; then
      source_host=$(jq -r '.source.server.host // empty' "$CONFIG_FILE")
      source_user=$(jq -r '.source.server.user // empty' "$CONFIG_FILE")
      [[ -n "$source_host" && -n "$source_user" ]] || { fail_profile 'Remote source needs source.server.host and source.server.user'; return 1; }
      source_path="$source_user@$source_host:$source_path_json"
    elif [[ "$source_kind" == this_machine ]]; then
      source_path="$source_path_json"
    else
      fail_profile 'source.kind must be remote or this_machine'
      return 1
    fi
  else
    while IFS= read -r line || [[ -n "$line" ]]; do
      line_number=$((line_number + 1))
      [[ -z "$line" ]] && continue
      case "$line" in \#*) continue ;; esac
      [[ "$line" == *=* ]] || { fail_profile "$CONFIG_FILE:$line_number: expected KEY=value"; return 1; }
      key=${line%%=*}
      value=${line#*=}
      case "$key" in
        SERVER) server=$value ;;
        USER) user=$value ;;
        SSH_PORT) ssh_port=$value ;;
        SOURCE) source_path=$value ;;
        DEST) dest=$value ;;
        SSH_PASSWORD) ssh_password=$value ;;
        SOURCE_SSH_PORT) source_ssh_port=$value ;;
        SOURCE_SSH_PASSWORD) source_ssh_password=$value ;;
        *) fail_profile "$CONFIG_FILE:$line_number: unknown key '$key'"; return 1 ;;
      esac
    done < "$CONFIG_FILE"
  fi

  [[ -n "$server" && -n "$user" ]] || { fail_profile 'SERVER and USER are required'; return 1; }
  [[ "$ssh_port" =~ ^[0-9]+$ ]] && (( ssh_port >= 1 && ssh_port <= 65535 )) || { fail_profile 'SSH_PORT must be from 1 to 65535'; return 1; }
  [[ "$source_ssh_port" =~ ^[0-9]+$ ]] && (( source_ssh_port >= 1 && source_ssh_port <= 65535 )) || { fail_profile 'SOURCE_SSH_PORT must be from 1 to 65535'; return 1; }
  [[ -n "$dest" && "$dest" == /* ]] || { fail_profile 'DEST must be an absolute remote path'; return 1; }

  if [[ "$source_path" =~ ^[^/:]+@[^/:]+:.+ ]]; then
    remote_source=true
    source_remote="$source_path"
    source_host=${source_path%%:*}
    [[ "$source_remote" == */ ]] || source_remote+="/"
  else
    [[ "$source_path" == /* ]] || source_path="$PWD/$source_path"
    [[ -d "$source_path" ]] || { fail_profile "Source directory not found: $source_path"; return 1; }
  fi

  check_dependencies ssh rsync || return 1
  host="$user@$server"
  dest_ssh="ssh -p $ssh_port -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=2"
  source_ssh="ssh -p $source_ssh_port -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=2"
  if [[ -z "$ssh_password" ]]; then dest_ssh+=" -o BatchMode=yes"; else dest_ssh+=" -o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no"; fi
  if [[ -z "$source_ssh_password" ]]; then source_ssh+=" -o BatchMode=yes"; else source_ssh+=" -o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no"; fi

  if [[ -n "$ssh_password" || ( "$remote_source" == true && -n "$source_ssh_password" ) ]]; then
    check_dependencies mktemp chmod rm || return 1
    askpass_helper=$(mktemp "${TMPDIR:-/tmp}/yas-webdeploy-askpass.XXXXXX") || { fail_profile 'Could not create SSH askpass helper'; return 1; }
    printf '#!/bin/sh\nprintf "%%s\\n" "$YAS_WEBDEPLOY_ASKPASS_PASSWORD"\n' > "$askpass_helper"
    chmod 700 "$askpass_helper" || { rm -f -- "$askpass_helper"; fail_profile 'Could not secure SSH askpass helper'; return 1; }
  fi

  if [[ "$SYNC_WITHOUT_DELAY" == true ]]; then
    run_sync_without_delay "$server" "$user" "$ssh_port" "$dest" "$ssh_password" "$source_path" "$source_ssh_port" "$source_ssh_password" "$relay_tmpdir"
    return $?
  fi

  cleanup_profile() {
    [[ -z "$relay_dir" ]] || find "$relay_dir" -depth -delete
    [[ -z "$askpass_helper" ]] || rm -f -- "$askpass_helper"
  }
  trap cleanup_profile EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  printf '\n%s%sYAS WEBDEPLOY%s\n' "$C_BOLD" "$C_CYAN" "$C_RESET"
  say_info "Target: $host:$dest"
  say_info "SSH port: $ssh_port"
  if [[ "$remote_source" == true ]]; then
    say_info "Remote source: $source_remote"
    say_info 'Relay: remote source -> this machine -> destination'
    relay_dir=$(mktemp -d "${relay_tmpdir%/}/yas-webdeploy-relay.XXXXXX") || { fail_profile 'Could not create local relay directory'; return 1; }
    say_step 'Downloading source to temporary local relay'
    if [[ -n "$source_ssh_password" ]]; then
      YAS_WEBDEPLOY_ASKPASS_PASSWORD="$source_ssh_password" SSH_ASKPASS="$askpass_helper" SSH_ASKPASS_REQUIRE=force DISPLAY="$askpass_display" rsync -az --human-readable --info=progress2 --no-inc-recursive --stats --timeout=30 -e "$source_ssh" "$source_remote" "$relay_dir/"
    else
      rsync -az --human-readable --info=progress2 --no-inc-recursive --stats --timeout=30 -e "$source_ssh" "$source_remote" "$relay_dir/"
    fi
    source_path="$relay_dir/"
  fi

  printf -v dest_path_q '%q' "$dest"
  say_step 'Creating destination directory'
  if [[ -n "$ssh_password" ]]; then
    YAS_WEBDEPLOY_ASKPASS_PASSWORD="$ssh_password" SSH_ASKPASS="$askpass_helper" SSH_ASKPASS_REQUIRE=force DISPLAY="$askpass_display" ssh -p "$ssh_port" -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$host" "mkdir -p -- $dest_path_q"
  else
    ssh -p "$ssh_port" -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o BatchMode=yes "$host" "mkdir -p -- $dest_path_q"
  fi

  say_step 'Uploading source to destination (overall progress)'
  if [[ -n "$ssh_password" ]]; then
    YAS_WEBDEPLOY_ASKPASS_PASSWORD="$ssh_password" SSH_ASKPASS="$askpass_helper" SSH_ASKPASS_REQUIRE=force DISPLAY="$askpass_display" rsync -az --human-readable --info=progress2 --no-inc-recursive --stats --timeout=30 -e "$dest_ssh" "$source_path" "$host:$dest/"
  else
    rsync -az --human-readable --info=progress2 --no-inc-recursive --stats --timeout=30 -e "$dest_ssh" "$source_path" "$host:$dest/"
  fi
  say_success 'Deployment completed'
}

if [[ "${1:-}" == -h || "${1:-}" == --help ]]; then show_help; exit 0; fi
if (( $# > 1 )); then show_help >&2; exit 2; fi
if [[ "${CONFIG_FILE##*.}" != json ]]; then
  run_key_value_profile
  exit $?
fi

ensure_config_file_is_in_gitignore
[[ ! -f "$CONFIG_FILE" ]] && create_default_config

check_dependencies "${BASE_DEPENDENCIES[@]}"
if jq -e '(.this_machine | type == "object") and (.source | type == "object") and (.destination | type == "object") and (.deployments | type == "array")' "$CONFIG_FILE" >/dev/null; then
  run_key_value_profile
  exit $?
fi
if [[ "$SYNC_WITHOUT_DELAY" == true ]]; then
  say_error 'The legacy JSON schema cannot use --sync-without-delai; use the nested source/destination profile.'
  exit 2
fi
jq -e 'type == "object" and (.deploys | type == "object")' "$CONFIG_FILE" >/dev/null || {
  say_error "Invalid JSON config or missing deploys object: $CONFIG_FILE"
  exit 1
}

SERVER=$(jq -r '.server // empty' "$CONFIG_FILE")
USER=$(jq -r '.user // empty' "$CONFIG_FILE")
SSH_PORT=$(jq -r '.ssh_port // 22' "$CONFIG_FILE")
METHOD=$(jq -r '.method // "ssh"' "$CONFIG_FILE")
UNSAFE_MODE=$(jq -r '.unsafe_mode // false' "$CONFIG_FILE")
SSH_PASSWORD=$(jq -r '.ssh_password // ""' "$CONFIG_FILE")
SUDO_PASSWORD=$(jq -r '.sudo_password // ""' "$CONFIG_FILE")
REMOTE_CHOWN=$(jq -r '.remote_chown // ""' "$CONFIG_FILE")
REMOTE_DIR_MODE=$(jq -r '.remote_dir_mode // "755"' "$CONFIG_FILE")
REMOTE_FILE_MODE=$(jq -r '.remote_file_mode // "644"' "$CONFIG_FILE")
RSYNC_REMOTE_SUDO=$(jq -r '.remote_sudo // false' "$CONFIG_FILE")
REMOTE_STAGING_ROOT=$(jq -r '.remote_staging_root // "~/.web-sync-staging"' "$CONFIG_FILE")
[[ -n "$SERVER" && -n "$USER" ]] || { say_error "Config requires server and user"; exit 1; }
[[ "$SSH_PORT" =~ ^[0-9]+$ ]] && (( SSH_PORT >= 1 && SSH_PORT <= 65535 )) || { say_error "ssh_port must be an integer from 1 to 65535"; exit 1; }
[[ "$METHOD" == "ssh" || "$METHOD" == "sftp" ]] || { say_error "Unsupported method: $METHOD"; exit 1; }
if [[ "$UNSAFE_MODE" != "true" && "$UNSAFE_MODE" != "1" ]]; then
  SSH_PASSWORD=""
  SUDO_PASSWORD=""
fi

DEPENDENCIES=("${BASE_DEPENDENCIES[@]}")
case "$METHOD" in
  ssh) DEPENDENCIES+=("${SSH_DEPENDENCIES[@]}") ;;
  sftp) DEPENDENCIES+=("${SFTP_DEPENDENCIES[@]}") ;;
esac
if [[ -n "$SSH_PASSWORD" ]]; then DEPENDENCIES+=("${SSH_PASSWORD_DEPENDENCIES[@]}"); fi
if [[ -n "$SUDO_PASSWORD" ]]; then DEPENDENCIES+=("${SUDO_PASSWORD_DEPENDENCIES[@]}"); fi
if [[ -f "$GITIGNORE_FILE" ]]; then DEPENDENCIES+=("${GITIGNORE_DEPENDENCIES[@]}"); fi
check_dependencies "${DEPENDENCIES[@]}"

echo ""
echo ""
printf '%s%sWEB SYNC (•) DEPLOY%s\n' "$C_BOLD" "$C_CYAN" "$C_RESET"
printf '%sFast Private Alternative to Git Push\n' "$C_CYAN"
printf 'Intelligent sync with gitignore respect, excludes .git,\n'
printf 'optimized transfers, and interactive deployment%s\n' "$C_RESET"
printf '%s────────────────────────────────────────%s\n' "$C_BLUE" "$C_RESET"
say_info "Target: $USER@$SERVER"
say_info "Method: $METHOD"
[[ "$METHOD" != ssh ]] || say_info "SSH port: $SSH_PORT"
echo ""

HOST="$USER@$SERVER"
SSH_OPTIONS=(-p "$SSH_PORT")
RSYNC_SSH="ssh -p $SSH_PORT"

if [[ -n "$SSH_PASSWORD" ]]; then
  export SSHPASS="$SSH_PASSWORD"
  ssh() { command sshpass -e ssh "$@"; }
  rsync() { command sshpass -e rsync "$@"; }
  RSYNC_SSH="sshpass -e ssh -p $SSH_PORT"
fi

say_step "Checking configured deployments"
enabled_deploys=$(jq -r '.deploys | to_entries[] | select(if (.value | has("enable")) then (.value.enable == true or .value.enable == 1) else true end) | [.key, .value.source, .value.dest, .value.type] | @tsv' "$CONFIG_FILE")
[[ -n "$enabled_deploys" ]] || { say_error "No enabled deployments configured"; exit 1; }
while IFS=$'\t' read -r INSTANCE source_input TARGET CONTEXT; do
  if [[ -z "$source_input" || -z "$TARGET" || -z "$CONTEXT" ]]; then
    say_error "Deployment '$INSTANCE' requires source, dest, and type"; exit 1
  fi
  if [[ "$source_input" = /* ]]; then SOURCE="$source_input"; else SOURCE="$CONFIG_DIR/$source_input"; fi
  if [[ ! -d "$SOURCE" ]]; then say_error "Source directory does not exist: $SOURCE"; exit 1; fi
  SOURCE="$(cd -- "$SOURCE" && pwd)/"

  say_step "$INSTANCE · $CONTEXT"
  say_info "Source: ${SOURCE%/}"
  say_info "Destination: $TARGET"
  say_info "Preparing transfer via $METHOD"
  case $METHOD in
  ssh)
    build_rsync_excludes "$CONTEXT"
    if [[ -n "${REMOTE_CHOWN:-}" ]]; then
      if [[ ! "${REMOTE_CHOWN}" =~ ^[^:]+:[^:]+$ ]]; then
        echo "REMOTE_CHOWN must use owner:group form, for example yassine:www-data"
        exit 1
      fi
      if [[ "${RSYNC_REMOTE_SUDO:-false}" != "true" ]]; then
        echo "REMOTE_CHOWN requires RSYNC_REMOTE_SUDO=true"
        exit 1
      fi
    fi
    if [[ "${RSYNC_REMOTE_SUDO:-false}" == "true" ]]; then
      stage_instance="${INSTANCE//[^A-Za-z0-9_.-]/_}"
      remote_stage="${REMOTE_STAGING_ROOT%/}/$stage_instance"
      printf -v remote_stage_q '%q' "$remote_stage"
      printf -v remote_target_q '%q' "$TARGET"
      ssh "${SSH_OPTIONS[@]}" "$HOST" "mkdir -p -- $remote_stage_q"
      say_info "Uploading files to remote staging directory"
      rsync -avz --progress -e "$RSYNC_SSH" --no-perms --no-owner --no-group "${RSYNC_EXCLUDES[@]}" "$SOURCE" "$HOST:$remote_stage/"

      printf -v remote_chmod_arg '%q' "D${REMOTE_DIR_MODE:-755},F${REMOTE_FILE_MODE:-644}"
      sudo_prefix="sudo"
      if [[ -n "$SUDO_PASSWORD" ]]; then
        encoded_sudo_password="$(printf '%s' "$SUDO_PASSWORD" | base64 | tr -d '\n')"
        askpass_path="$remote_stage/.askpass"
        ssh "${SSH_OPTIONS[@]}" "$HOST" "mkdir -p -- $remote_stage_q && printf '%s' '$encoded_sudo_password' | base64 -d > '$askpass_path' && chmod 700 '$askpass_path'"
        sudo_prefix="SUDO_ASKPASS=$askpass_path sudo -A"
      fi
      publish_command="$sudo_prefix rsync -av --ignore-times --chmod=$remote_chmod_arg"
            if [[ -n "${REMOTE_CHOWN:-}" ]]; then
        printf -v remote_chown_arg '%q' "--chown=$REMOTE_CHOWN"
        publish_command+=" $remote_chown_arg"
      fi
      publish_command+=" -- $remote_stage_q/ $remote_target_q/"
      say_info "Publishing staged files to destination"
      ssh "${SSH_OPTIONS[@]}" -tt "$HOST" "$publish_command"
      ssh "${SSH_OPTIONS[@]}" "$HOST" "rm -rf -- $remote_stage_q"
    else
      rsync_options=(--chmod="D${REMOTE_DIR_MODE:-755},F${REMOTE_FILE_MODE:-644}")
      rsync_identity_options=(--no-owner --no-group)
      say_info "Syncing files (live rsync progress follows)"
      rsync -avz --progress -e "$RSYNC_SSH" "${rsync_identity_options[@]}" "${rsync_options[@]}" "${RSYNC_EXCLUDES[@]}" "$SOURCE" "$HOST:$TARGET/"
    fi

    run_post_deploy "$HOST" "$TARGET" "$CONTEXT"
    ;;
  sftp)
    if [[ -n "${REMOTE_CHOWN:-}" || "${RSYNC_REMOTE_SUDO:-false}" == "true" ]]; then
      echo "SFTP cannot apply REMOTE_CHOWN, remote sudo, or configured permissions. Select SSH (rsync) instead."
      exit 1
    fi
    say_warn "SFTP does not support context-aware deployment"
    sftp -P "$SSH_PORT" "$HOST" <<EOF
cd $TARGET
put -r ${SOURCE%/}/*
EOF
    ;;
  *)
    echo "Unknown method: $METHOD"
    exit 1
    ;;
esac
done <<< "$enabled_deploys"

say_success "All enabled deployments completed successfully"
exit 0
